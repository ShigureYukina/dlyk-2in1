<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>io.github.shigureyukina</groupId>
    <artifactId>dlyk-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>dlyk-server</name>
    <description>dlyk-server</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!--
          Elasticsearch 检索：Boot 托管 8.11.x 客户端，自动装配 co.elastic.clients 的
          ElasticsearchClient（连接地址见 spring.elasticsearch.uris）。
          索引/查询不经过 Spring Data 仓库，直接用官方 client 写 DSL，
          分析器与映射定义见 resources/elasticsearch/。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-elasticsearch</artifactId>
        </dependency>

        <!--
          ShardingSphere-JDBC（分表，仅 sharding profile 生效，见 application-sharding.yml）。
          5.3+ 移除了 spring-boot-starter，走 JDBC 驱动模式：
          spring.datasource.url=jdbc:shardingsphere:classpath:sharding.yaml，
          与 MyBatis/PageHelper 无冲突（SS 自带 SQL 解析器，不依赖 jsqlparser）。
          用 5.5.3：5.5.0 的 pom 依赖了未发布到中央仓库的 shardingsphere-test-util（官方打包事故）。
        -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-jdbc</artifactId>
            <version>5.5.3</version>
        </dependency>
        <!-- SS 5.5.3 依赖 commons-lang3 3.18+ 的 Strings API（NoClassDefFoundError: Strings），
             必须显式钉版本压过 Boot 3.2 托管的 3.13 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.18.0</version>
        </dependency>
        <!-- 5.5.x 把配置 URL 加载器拆成了独立模块：classpath: / absolutepath: 前缀各需一个 -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-infra-url-classpath</artifactId>
            <version>5.5.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-infra-url-absolutepath</artifactId>
            <version>5.5.3</version>
        </dependency>
        <!-- actualDataNodes 里 ${0..3} 这类内联表达式由 Groovy 引擎展开（5.5 默认引擎） -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-infra-expr-groovy</artifactId>
            <version>5.5.3</version>
        </dependency>
        <!-- 5.5.x 的 shardingsphere-jdbc 聚合包不再自带功能规则：
             缺了它，YAML 里的 !SHARDING 标签无法解析（Invalid tag） -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-sharding-core</artifactId>
            <version>5.5.3</version>
        </dependency>
        <!-- Hikari 池元数据 SPI（url↔jdbcUrl 同义词表在这里）：
             缺了它数据源 props 全部识别失败，启动期在 StorageUnit 直接 NPE -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-infra-data-source-pool-hikari</artifactId>
            <version>5.5.3</version>
        </dependency>
        <!-- Standalone 模式构建器与其元数据仓库（5.5.x 聚合包只带 cluster-mode）。
             元数据仓库用 memory：单机演练不需要持久化模式元数据 -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-standalone-mode-core</artifactId>
            <version>5.5.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-standalone-mode-repository-memory</artifactId>
            <version>5.5.3</version>
        </dependency>
        <!-- 权限提供者 SPI 的默认实现（ALL_PERMITTED）在这里，聚合包不带 -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-authority-simple</artifactId>
            <version>5.5.3</version>
        </dependency>
        <!-- MySQL 方言 SQL 解析器（执行 SQL 时按 dialect 加载，聚合包不带） -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-parser-sql-engine-mysql</artifactId>
            <version>5.5.3</version>
        </dependency>

        <!--
          MyBatis-Plus：在 MyBatis 之上提供通用 CRUD 与条件构造器。
          项目原有的 @Mapper 接口 + XML 映射全部继续可用（MP 兼容原生 MyBatis），
          只有需要通用 CRUD 的新 Mapper 才继承 BaseMapper。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.7</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          PageHelper 分页依赖

          版本必须与 MyBatis-Plus 传递进来的 jsqlparser 4.9 对齐：
          1.4.7 依赖 jsqlparser 3.x 的 SelectBody，而该类在 jsqlparser 4.7 已被移除，
          混用会在启动时抛 NoClassDefFoundError。
        -->
        <dependency>
            <groupId>com.github.pagehelper</groupId>
            <artifactId>pagehelper-spring-boot-starter</artifactId>
            <version>2.0.0</version>
        </dependency>

        <!--
          显式钉住 jsqlparser 版本。

          MyBatis-Plus 3.5.7 传递进来的是 jsqlparser 4.9，而 PageHelper 6.0.0
          依赖的是 4.5：SelectBody 这个类在 jsqlparser 4.7 被移除，
          PageHelper 的 AbstractDialect 仍在引用它，版本被顶高后分页查询会抛
          NoClassDefFoundError。

          本项目的 SQL 改写只由 PageHelper 做（未启用 MP 的 PaginationInnerInterceptor），
          因此把 jsqlparser 钉回 PageHelper 需要的 4.5 是安全的。
        -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <version>4.5</version>
        </dependency>

        <!-- alibaba的easyexcel依赖 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
            <version>3.3.3</version>
        </dependency>

        <!-- Caffeine缓存依赖 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>3.1.8</version>
        </dependency>

        <!-- JWT依赖 -->
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
            <version>4.2.1</version>
        </dependency>

        <!-- ===== 高并发治理与分布式调度 ===== -->

        <!-- Redisson: Redis 分布式锁 / 看门狗续期 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>3.27.2</version>
        </dependency>

        <!-- XXL-Job: 分布式任务调度（失败重试 + 分片广播） -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
            <version>2.4.1</version>
        </dependency>

        <!-- RabbitMQ: 事件异步化解耦 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- ===== 可观测性 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!--
                          测试期专用签名密钥，**不是任何环境的真实密钥**，只作用于 surefire。
                          为什么需要它：JWTUtils 按 b5d88bb 的要求「仓库内不落任何默认密钥」，
                          缺 JWT_SECRET 时直接快速失败。这在 CI 里没问题（ci.yml 设了环境变量），
                          但本地 `mvn test` 会让 CustomerManagerTest 这类需要签发 token 的用例
                          整类报 ExceptionInInitializerError，看起来像代码坏了，其实只是没给变量。
                          真实密钥仍然只能从环境变量 / -D 传入，这里只是给测试兜底。
                        -->
                        <jwt.secret>test-only-secret-do-not-use-in-any-real-env</jwt.secret>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
{
  "index.max_ngram_diff": 10,
  "number_of_shards": 1,
  "number_of_replicas": 0,
  "analysis": {
    "analyzer": {
      "dlyk_ngram": {
        "type": "custom",
        "tokenizer": "dlyk_ngram_tokenizer",
        "filter": ["lowercase"]
      }
    },
    "tokenizer": {
      "dlyk_ngram_tokenizer": {
        "type": "ngram",
        "min_gram": 1,
        "max_gram": 10,
        "token_chars": ["letter", "digit"]
      }
    }
  }
}
